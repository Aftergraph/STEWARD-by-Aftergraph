{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/schemas/steward-delegated-authority-1.0.json",
  "title": "STEWARD Delegated Authority 1.0",
  "description": "A delegation grant binding an agent persona to bounded authority. Authority originates outside the agent: the grant references an external authority source (AIE), is attenuated against the parent capability set, and may be revoked or expired. An agent acting without a valid grant is unauthorized by definition. Verification capabilities additionally require a Sentinel binding; an agent may never self-verify.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grant_id",
    "grantee_persona_id",
    "authority_source",
    "capabilities",
    "parent_capabilities",
    "granted_at",
    "expires_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "steward.delegated-authority/1.0"
    },
    "grant_id": {
      "type": "string",
      "minLength": 1
    },
    "grantee_persona_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "grant_ref"],
      "properties": {
        "owner": {
          "enum": ["aie", "trust-gateway", "steward-maintainer"]
        },
        "grant_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+(:[a-z0-9.-]+)?$"
      }
    },
    "parent_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+(:[a-z0-9.-]+)?$"
      }
    },
    "verification_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_owner", "verifier_ref"],
      "properties": {
        "verifier_owner": {
          "const": "sentinel"
        },
        "verifier_ref": {
          "type": "string",
          "minLength": 1
        },
        "subject_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        }
      }
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["granted", "revoked", "expired"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "revoked" } }
      },
      "then": {
        "required": ["revoked_at"]
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "type": "array",
            "contains": { "enum": ["verify:exact-subject", "verify:projection"] }
          }
        }
      },
      "then": {
        "required": ["verification_binding"]
      }
    }
  ]
}
