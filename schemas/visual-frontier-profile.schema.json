{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergraph.org/schemas/steward-visual-frontier-profile-1.3.json",
  "title": "STEWARD Visual Frontier Profile 1.3",
  "description": "Renderer/evidence profile for STEWARD presence. It is presentation-only and does not own brand identity, authority, execution truth, or verification truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "identity_owner",
    "renderer_owner",
    "source_scene",
    "runtime",
    "state_assets",
    "compact_presence",
    "motion_runtime",
    "presentation_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "steward.visual-frontier-profile/1.3"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "identity_owner": {
      "const": "Aftergraph/brand"
    },
    "renderer_owner": {
      "const": "Aftergraph/STEWARD-by-Aftergraph"
    },
    "source_scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "project_id",
        "revision",
        "armature",
        "bone_count",
        "proportion_profile",
        "material_profile",
        "geometry_topology_changed",
        "armature_changed"
      ],
      "properties": {
        "provider": {
          "const": "higgsfield-3d-jutsu"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "armature": {
          "const": "STEWARD_Rig"
        },
        "bone_count": {
          "const": 20
        },
        "proportion_profile": {
          "const": "frontier-proportions/1.0"
        },
        "material_profile": {
          "const": "frontier-material/1.1"
        },
        "geometry_topology_changed": {
          "const": false
        },
        "armature_changed": {
          "const": false
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_renderer",
        "verified_model",
        "asset_path",
        "asset_sha256",
        "source_commit",
        "required_clips",
        "material_profile",
        "proportion_profile",
        "portable_lighting"
      ],
      "properties": {
        "primary_renderer": {
          "const": "webgl-threejs"
        },
        "verified_model": {
          "const": "verified-rig-glb"
        },
        "asset_path": {
          "const": "/assets/steward-rig-v2.glb"
        },
        "asset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "required_clips": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "enum": [
              "idle",
              "blink",
              "verify"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "idle"
              }
            },
            {
              "contains": {
                "const": "blink"
              }
            },
            {
              "contains": {
                "const": "verify"
              }
            }
          ]
        },
        "material_profile": {
          "const": "frontier-material/1.1"
        },
        "proportion_profile": {
          "const": "frontier-proportions/1.0"
        },
        "portable_lighting": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "enum": [
              "SUN",
              "POINT",
              "SPOT"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "SUN"
              }
            },
            {
              "contains": {
                "const": "POINT"
              }
            },
            {
              "contains": {
                "const": "SPOT"
              }
            }
          ]
        }
      }
    },
    "state_assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "manifest_path",
        "source_revision",
        "proportion_profile",
        "material_profile",
        "states",
        "transparent",
        "geometry_topology_changed",
        "armature_changed"
      ],
      "properties": {
        "schema_version": {
          "const": "steward.rig-state-assets/4.0"
        },
        "manifest_path": {
          "const": "/assets/rig-states/rig-state-manifest-v4.json"
        },
        "source_revision": {
          "const": 5
        },
        "proportion_profile": {
          "const": "frontier-proportions/1.0"
        },
        "material_profile": {
          "const": "frontier-material/1.1"
        },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "enum": [
              "idle",
              "thinking",
              "planning",
              "executing",
              "inspecting",
              "waiting",
              "blocked",
              "approval",
              "verifying",
              "approving",
              "succeeded",
              "failed"
            ]
          }
        },
        "transparent": {
          "const": true
        },
        "geometry_topology_changed": {
          "const": false
        },
        "armature_changed": {
          "const": false
        }
      }
    },
    "presentation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_class",
        "canonical_truth",
        "authority_effect",
        "verification_effect"
      ],
      "properties": {
        "claim_class": {
          "const": "projection-only"
        },
        "canonical_truth": {
          "const": false
        },
        "authority_effect": {
          "const": false
        },
        "verification_effect": {
          "const": false
        }
      }
    },
    "compact_presence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "manifest_path",
        "source_revision",
        "source_commit",
        "proportion_profile",
        "material_profile",
        "states",
        "geometry_unchanged"
      ],
      "properties": {
        "schema_version": {
          "const": "steward.compact-presence-assets/1.0"
        },
        "manifest_path": {
          "const": "/assets/compact-presence/manifest-v1.json"
        },
        "source_revision": {
          "const": 5
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "proportion_profile": {
          "const": "frontier-proportions/1.0"
        },
        "material_profile": {
          "const": "frontier-material/1.1"
        },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "enum": [
              "idle",
              "verifying",
              "succeeded"
            ]
          }
        },
        "geometry_unchanged": {
          "const": true
        }
      }
    },
    "motion_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_owner",
        "contract_id",
        "runtime_version",
        "manifest_path",
        "manifest_sha256",
        "source_commit",
        "states",
        "motions",
        "accent_tokens",
        "transition_ms_min",
        "transition_ms_max",
        "blink_seconds_min",
        "blink_seconds_max",
        "pointer_orientation_max_degrees",
        "reduced_motion",
        "qa"
      ],
      "properties": {
        "contract_owner": {
          "const": "Aftergraph/brand"
        },
        "contract_id": {
          "const": "steward.presence.v1"
        },
        "runtime_version": {
          "const": "steward.motion-runtime/2.0"
        },
        "manifest_path": {
          "const": "/assets/motion/presence-runtime-v2.json"
        },
        "manifest_sha256": {
          "const": "047464f20b75763d14d969fbb14fa16780a7d6dfdb554cb3a90e9e8809e92378"
        },
        "source_commit": {
          "const": "4c71ce1322281056c70dd896abefc03936fd43f6"
        },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "enum": [
              "idle",
              "thinking",
              "planning",
              "executing",
              "inspecting",
              "waiting",
              "blocked",
              "approval",
              "verifying",
              "approving",
              "succeeded",
              "failed"
            ]
          }
        },
        "motions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idle",
            "thinking",
            "planning",
            "executing",
            "inspecting",
            "waiting",
            "blocked",
            "approval",
            "verifying",
            "approving",
            "succeeded",
            "failed"
          ],
          "properties": {
            "idle": {
              "const": "ambient_breathe"
            },
            "thinking": {
              "const": "visor_attention"
            },
            "planning": {
              "const": "ordered_scan"
            },
            "executing": {
              "const": "forward_action"
            },
            "inspecting": {
              "const": "focus_scan"
            },
            "waiting": {
              "const": "slow_hold"
            },
            "blocked": {
              "const": "boundary_stop"
            },
            "approval": {
              "const": "attention_gate"
            },
            "verifying": {
              "const": "custody_ring_raise"
            },
            "approving": {
              "const": "bounded_confirm"
            },
            "succeeded": {
              "const": "settled_confirm"
            },
            "failed": {
              "const": "bounded_break"
            }
          }
        },
        "accent_tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idle",
            "thinking",
            "planning",
            "executing",
            "inspecting",
            "waiting",
            "blocked",
            "approval",
            "verifying",
            "approving",
            "succeeded",
            "failed"
          ],
          "properties": {
            "idle": {
              "const": "steward_copper"
            },
            "thinking": {
              "const": "steward_copper"
            },
            "planning": {
              "const": "system_blue"
            },
            "executing": {
              "const": "decision_amber"
            },
            "inspecting": {
              "const": "control_cyan"
            },
            "waiting": {
              "const": "slate"
            },
            "blocked": {
              "const": "decision_amber"
            },
            "approval": {
              "const": "authority_violet"
            },
            "verifying": {
              "const": "pine_teal"
            },
            "approving": {
              "const": "authority_violet"
            },
            "succeeded": {
              "const": "moss"
            },
            "failed": {
              "const": "decision_amber"
            }
          }
        },
        "transition_ms_min": {
          "const": 160
        },
        "transition_ms_max": {
          "const": 420
        },
        "blink_seconds_min": {
          "const": 3.5
        },
        "blink_seconds_max": {
          "const": 5.5
        },
        "pointer_orientation_max_degrees": {
          "const": 6
        },
        "reduced_motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "continuous_motion",
            "transition_ms",
            "preserve_state_label",
            "preserve_final_pose"
          ],
          "properties": {
            "continuous_motion": {
              "const": false
            },
            "transition_ms": {
              "const": 0
            },
            "preserve_state_label": {
              "const": true
            },
            "preserve_final_pose": {
              "const": true
            }
          }
        },
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all_states",
            "normal_pixels_changed",
            "reduced_pixels_stable",
            "auto_sequence_advanced",
            "console_errors_zero"
          ],
          "properties": {
            "all_states": {
              "const": true
            },
            "normal_pixels_changed": {
              "const": true
            },
            "reduced_pixels_stable": {
              "const": true
            },
            "auto_sequence_advanced": {
              "const": true
            },
            "console_errors_zero": {
              "const": true
            }
          }
        }
      }
    }
  }
}
