{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aftergraph.steward.mission.v0.1",
  "title": "MissionRef",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "missionId",
    "projectId",
    "goal",
    "acceptanceCriteria"
  ],
  "properties": {
    "missionId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "authorityRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "riskControlsRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "budgetRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "graphVersion": {
      "type": "integer",
      "minimum": 1
    }
  }
}
